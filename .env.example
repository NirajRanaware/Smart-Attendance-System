# ==============================================================================
# Smart Attendance Management System — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' (do NOT commit '.env' to version control).
# 2. Replace the placeholder values below with your specific environment settings.
# 3. Always keep private keys, secrets, and credentials outside tracked Git files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Flask Application & Core Security
# ------------------------------------------------------------------------------
# Application environment ('development', 'production', or 'testing')
FLASK_ENV=development

# Cryptographic secret key for session cookies and CSRF protection
# In production, replace with a 64+ character random hex or base64 token
SECRET_KEY=replace-with-a-secure-random-secret-key-for-session-signing

# Institutional default timezone (Asia/Kolkata = UTC+05:30)
DEFAULT_TIMEZONE=Asia/Kolkata

# Require HTTPS for session cookies (must be 'true' in production with TLS/SSL)
SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 2. Hardware Device Authentication (POST /api/scans)
# ------------------------------------------------------------------------------
# JSON object mapping registered device_id to its pre-shared API key (min 32 chars).
# The ESP32 device transmits these in 'X-Device-Id' and 'X-API-Key' headers.
DEVICE_API_KEYS={"ESP32_ATTENDANCE_01": "replace-with-minimum-32-character-device-api-key"}

# ------------------------------------------------------------------------------
# 3. Google Sheets Integration & Service Account Authentication
# ------------------------------------------------------------------------------
# Service Account Credential Path Resolution Precedence:
# 1. GOOGLE_SERVICE_ACCOUNT_FILE (if explicitly set)
# 2. GOOGLE_APPLICATION_CREDENTIALS (standard Google Cloud SDK convention)
# 3. Safe fallback default: credentials/service_account.json
#
# IMPORTANT SECURITY DIRECTIVE:
# Store the service account JSON key OUTSIDE the repository directory:
# Example: C:/Users/username/.config/smart-attendance/google-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/username/.config/smart-attendance/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_FILE=

# Google Spreadsheet ID (from spreadsheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-spreadsheet-id-here

# Target worksheet / tab name within the spreadsheet (default: Attendance_Log)
GOOGLE_SHEETS_SHEET_NAME=Attendance_Log

# ------------------------------------------------------------------------------
# 4. Google Sheets Background Worker Configuration
# ------------------------------------------------------------------------------
# Enable or disable background synchronization worker
GOOGLE_SHEETS_SYNC_ENABLED=true

# Polling interval in seconds between outbox queue checks
GOOGLE_SHEETS_SYNC_POLL_INTERVAL=10

# Maximum attendance records to claim and append per batch
GOOGLE_SHEETS_SYNC_BATCH_SIZE=20

# Worker lease lock duration in seconds to prevent concurrent processing
GOOGLE_SHEETS_SYNC_LEASE_SECONDS=60
